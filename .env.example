# copy to .env

PORT=3000
BASE_URL=http://localhost:3000

# --- behind a reverse proxy ---
# Which hops are allowed to set X-Forwarded-For, i.e. which ones we believe about who the
# caller is. LEAVE BLANK HERE: running locally there is no proxy, and blank means the header
# is ignored entirely, so nobody can forge one to dodge the sign-in lockout.
#
# On the VPS this is already set to "loopback, uniquelocal" in docker-compose.yml, which wins
# over this file — Caddy connects from a Docker bridge address, so `loopback` alone would not
# match it and every visitor would arrive looking like the proxy.
#
# Accepted values: blank, `loopback`, `uniquelocal` (any private range), a CIDR like
# 172.16.0.0/12, a comma-separated list of those, or a hop count like `1`.
TRUST_PROXY=
# Bind address. 0.0.0.0 locally and inside the container; on the VPS what limits exposure is
# the port binding in docker-compose.yml (172.17.0.1:3000), not this.
HOST=0.0.0.0

# --- auth ---
# Bootstrap only: on the very first run this becomes the admin's password (min 10 chars).
# After that, people, passwords, passkeys, devices and permissions live in data/auth.json
# and are managed from the app. Leave it blank and a random password is printed to the console.
ACCESS_PASSWORD=change this passphrase
# Set false to disable MAC-based sign-in entirely and always require a password or passkey.
MAC_LOGIN=true

# --- google (calendar + drive) ---
# console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web)
# Authorized redirect URI: http://localhost:3000/auth/google/callback
# Enable: Google Calendar API, Google Drive API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_ID=primary

# --- spotify ---
# developer.spotify.com/dashboard > Redirect URI: http://localhost:3000/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- github ---
# Fine-grained PAT: github.com/settings/personal-access-tokens
#   Repository access: All repositories
#   Permissions: Metadata = Read-only, Pull requests = Read-only
# Nothing else — the app only calls /user, /user/repos, /users/:login/events and
# /search/issues, so Contents and Issues are not needed.
#
# Caveat: with a fine-grained token the activity feed shows public events only. Private-repo
# pushes appear only with a CLASSIC token carrying `repo`, which also grants write access —
# a bad trade for a read-only panel unless you specifically want that feed.
GITHUB_TOKEN=
