# copy to .env

PORT=3000
BASE_URL=http://localhost:3000

# --- behind a reverse proxy (see deploy/nginx/) ---
# Which hops may set X-Forwarded-For. `loopback` when nginx runs on the same host.
# Leave BLANK when nothing sits in front: the header is then ignored, so it cannot be
# spoofed to dodge the sign-in lockout or impersonate the server's own device.
TRUST_PROXY=
# Bind address. Set 127.0.0.1 behind a proxy so port 3000 is not reachable from outside.
HOST=0.0.0.0

# --- auth ---
# Bootstrap only: on the very first run this becomes the admin's 6-digit code.
# After that, people, codes, devices and permissions live in data/auth.json and are
# managed from the Access panel. Leave it blank and a random code is printed to the console.
ACCESS_CODE=123456
# Set false to disable MAC-based sign-in entirely and always require a code.
MAC_LOGIN=true

# --- google (calendar + drive) ---
# console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web)
# Authorized redirect URI: http://localhost:3000/auth/google/callback
# Enable: Google Calendar API, Google Drive API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_ID=primary

# --- spotify ---
# developer.spotify.com/dashboard > Redirect URI: http://localhost:3000/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- github ---
# github.com/settings/tokens - fine-grained PAT, read-only on repo metadata/contents
GITHUB_TOKEN=
